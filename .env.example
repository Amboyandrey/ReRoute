# --- Strong tier providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Nebius (mid tier + dataset generation) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# --- Self-hosted cheap tier (vLLM) ---
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# --- Router service ---
ROUTER_SERVICE_URL=http://localhost:9000
ROUTER_TIMEOUT_MS=150

# --- Gateway ---
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info
