# --- Strong tier providers ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Nebius (mid tier + dataset generation) ---
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1

# --- Self-hosted cheap tier (vLLM) ---
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct

# --- Router service ---
ROUTER_SERVICE_URL=http://localhost:9000
ROUTER_TIMEOUT_MS=150
# Phase 2 supervised policy (used by the router service, not the gateway).
# Only takes effect if router/supervised/checkpoints/v1/model.onnx exists;
# otherwise the router falls back to the length-based rule policy.
# See docs/phase2_supervised_curve.md for how this was picked.
ROUTER_SUPERVISED_THRESHOLD=0.3
ROUTER_CHECKPOINT_DIR=

# --- Gateway ---
GATEWAY_PORT=8080
GATEWAY_LOG_LEVEL=info
